"""
API tests for the role-based Swagger docs: /api/docs/openapi.json lists only the endpoints
the caller's role may call, and the endpoint catalog (app/policy/endpoints.py) matches the
real routes.
"""

import pytest

from app.core.security import create_access_token
from app.main import app
from app.models import UserRole
from app.policy.endpoints import ENDPOINTS
from tests.conftest import create_user

pytestmark = [pytest.mark.anyio, pytest.mark.integration]


async def visible_endpoints(client, token: str | None = None) -> set[str]:
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    response = await client.get("/api/docs/openapi.json", headers=headers)
    assert response.status_code == 200
    return {
        f"{method.upper()} {path}"
        for path, operations in response.json()["paths"].items()
        for method in operations
        if method in {"get", "post", "put", "patch", "delete"}
    }


async def token_for(db, role: UserRole) -> str:
    user = await create_user(db, f"docs_{role.value}", role)
    return create_access_token(user.username)


async def test_visitor_sees_only_public_endpoints(client):
    endpoints = await visible_endpoints(client)

    assert "POST /api/auth/login" in endpoints
    assert "GET /api/products" in endpoints
    assert "GET /api/auth/me" not in endpoints
    assert "GET /api/cart" not in endpoints
    assert "POST /api/admin/products" not in endpoints


async def test_customer_sees_shopping_endpoints_only(client, db):
    endpoints = await visible_endpoints(client, await token_for(db, UserRole.CUSTOMER))

    assert {"GET /api/cart", "POST /api/orders/checkout", "POST /api/orders/{order_id}/return-to-cart"} <= endpoints
    assert "GET /api/products" in endpoints  # public endpoints are shown to everyone
    assert "POST /api/admin/products" not in endpoints
    assert "GET /api/admin/orders" not in endpoints
    assert "POST /api/notifications/send" not in endpoints


async def test_support_sees_orders_and_notifications_but_no_cart_or_products(client, db):
    endpoints = await visible_endpoints(client, await token_for(db, UserRole.SUPPORT))

    assert {"GET /api/admin/orders", "GET /api/orders/{order_id}", "POST /api/notifications/send"} <= endpoints
    assert "GET /api/cart" not in endpoints
    assert "POST /api/admin/products" not in endpoints
    assert "GET /api/admin/audit-logs" not in endpoints


async def test_admin_sees_admin_endpoints_but_no_cart(client, db):
    endpoints = await visible_endpoints(client, await token_for(db, UserRole.ADMIN))

    assert {"POST /api/admin/products", "GET /api/admin/audit-logs", "GET /demo/sync-sleep"} <= endpoints
    assert "POST /api/cart/add" not in endpoints
    assert "POST /api/orders/checkout" not in endpoints


async def test_unused_schemas_are_hidden_too(client, db):
    response = await client.get(
        "/api/docs/openapi.json", headers={"Authorization": f"Bearer {await token_for(db, UserRole.CUSTOMER)}"}
    )
    schemas = response.json()["components"]["schemas"]

    assert "CartOut" in schemas
    assert "OrderItemOut" in schemas  # used inside OrderOut
    assert "ProductCreate" not in schemas  # only the admin's create-product endpoint uses it


async def test_bad_token_is_401(client):
    response = await client.get("/api/docs/openapi.json", headers={"Authorization": "Bearer not-a-token"})

    assert response.status_code == 401


async def test_full_description_is_not_public(client):
    assert (await client.get("/openapi.json")).status_code == 404
    assert (await client.get("/redoc")).status_code == 404
    assert (await client.get("/docs")).status_code == 200  # the role-based page


async def test_hidden_endpoints_are_still_protected(client, db):
    """Hiding is for clarity: calling a hidden endpoint by hand is still refused."""
    token = await token_for(db, UserRole.CUSTOMER)

    response = await client.post(
        "/api/admin/categories", json={"name": "Toys"}, headers={"Authorization": f"Bearer {token}"}
    )

    assert response.status_code == 403


def test_catalog_matches_the_real_routes():
    """Every catalog entry is a real route, and every real route is in the catalog."""
    real = {
        f"{method.upper()} {path}"
        for path, operations in app.openapi()["paths"].items()
        if not path.startswith("/demo")
        for method in operations
    }
    catalog = {f"{e.method} {e.path}" for e in ENDPOINTS}

    assert catalog - real == set(), "in the catalog but not a real route"
    assert real - catalog == set(), "a route is missing from app/policy/endpoints.py"








