"""
Role-based Swagger: build the OpenAPI document (what /docs shows) for ONE role.

Student notes:
- FastAPI describes the API in one big dict, app.openapi():
      {"paths": {"/api/cart": {"get": {...}}, ...}, "components": {"schemas": {...}}}
  Swagger UI only draws what is in that dict. So to hide an endpoint from a role, we
  remove it from a COPY of the dict before Swagger sees it.
- Which endpoints a role keeps is decided by role_may_call(), i.e. by policy.csv, the same
  rules that return 403. Hiding is only for clarity: the backend still enforces every rule,
  so an endpoint someone calls by hand (curl, Postman) still answers 401/403.
- Schemas (ProductCreate, OrderOut, ...) that only hidden endpoints use are removed too,
  so a customer doesn't see admin request bodies at the bottom of the page.
"""

import copy

from app.policy import role_may_call
from app.policy.endpoints import ENDPOINTS

HTTP_METHODS = {"get", "post", "put", "patch", "delete"}
CATALOG = {(e.method, e.path): e for e in ENDPOINTS}


def openapi_for_role(full_schema: dict, role: str | None) -> dict:
    """A copy of `full_schema` with only the operations `role` may call (None = no token)."""
    schema = copy.deepcopy(full_schema)  # never change the app's cached original

    kept_paths = {}
    for path, operations in schema["paths"].items():
        kept = {
            method: operation
            for method, operation in operations.items()
            if method not in HTTP_METHODS or _visible(role, method, path)
        }
        if any(method in HTTP_METHODS for method in kept):
            kept_paths[path] = kept
    schema["paths"] = kept_paths

    components = schema.get("components", {})
    if "schemas" in components:
        used = _used_schemas(kept_paths, components["schemas"])
        components["schemas"] = {name: s for name, s in components["schemas"].items() if name in used}

    who = role or "visitor (not logged in)"
    schema["info"]["description"] = f"**Showing the endpoints for: {who}.** " + (
        "Click **Authorize** and log in to see the endpoints of your role." if role is None else ""
    )
    return schema


def _visible(role: str | None, method: str, path: str) -> bool:
    endpoint = CATALOG.get((method.upper(), path))
    if endpoint is None:
        return role == "admin"  # not in the catalog (the /demo routes): admins only
    return role_may_call(role, endpoint)


def _used_schemas(paths: dict, all_schemas: dict) -> set[str]:
    """Names of the schemas the kept paths refer to, directly or through other schemas."""
    used: set[str] = set()
    to_visit = _refs(paths)
    while to_visit:
        name = to_visit.pop()
        if name in used or name not in all_schemas:
            continue
        used.add(name)
        to_visit |= _refs(all_schemas[name])  # e.g. OrderOut -> OrderItemOut
    return used


def _refs(node: object) -> set[str]:
    """Every "$ref": "#/components/schemas/<Name>" inside `node`, as a set of names."""
    if isinstance(node, dict):
        found = set()
        for key, value in node.items():
            if key == "$ref" and isinstance(value, str):
                found.add(value.rsplit("/", 1)[-1])
            else:
                found |= _refs(value)
        return found
    if isinstance(node, list):
        return set().union(*(_refs(item) for item in node)) if node else set()
    return set()


