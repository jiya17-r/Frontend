"""
Role-based Swagger UI: /docs shows each user only the endpoints their role may call.

Student notes:
- FastAPI's built-in /docs and /openapi.json are switched off in main.py (they show
  everything to everyone). This router serves two replacements:
      GET /docs                    the Swagger page (HTML + a little JavaScript)
      GET /api/docs/openapi.json   the API description, FILTERED for the caller's role
- How the page works:
      1. It opens with no token -> the visitor view: public endpoints + login.
      2. You click Authorize and log in -> the page asks /api/docs/openapi.json again,
         now WITH your token -> the server answers with only your role's endpoints.
      3. You click Logout -> back to the visitor view.
- Hiding is for clarity, not security: every endpoint still checks the token and
  policy.csv itself (401/403), whether it is visible here or not.
- Both routes use include_in_schema=False: they are not API endpoints and are never listed.
"""

from fastapi import APIRouter, Request
from fastapi.responses import HTMLResponse

from app.policy.openapi_filter import openapi_for_role
from app.routes.dependencies import OptionalUser

router = APIRouter(tags=["Docs"])

SWAGGER_UI = "https://cdn.jsdelivr.net/npm/swagger-ui-dist@5.17.14"

SWAGGER_PAGE = f"""<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ECommerce2 API - Swagger UI</title>
  <link rel="stylesheet" href="{SWAGGER_UI}/swagger-ui.css">
</head>
<body>
<div id="swagger-ui"></div>
<script src="{SWAGGER_UI}/swagger-ui-bundle.js"></script>
<script>
  const SPEC_URL = "/api/docs/openapi.json";
  let ready = false;       // the first (visitor) description has been drawn
  let shownToken = null;   // the token the shown description was made for (null = visitor)
  let lastRequest = 0;     // ignore answers to older requests

  // The access token Swagger got from the Authorize dialog, or null.
  function currentToken(system) {{
    const authorized = system.authSelectors.authorized();
    const schemes = authorized ? authorized.toJS() : {{}};
    for (const scheme of Object.values(schemes)) {{
      if (scheme && scheme.token && scheme.token.access_token) return scheme.token.access_token;
    }}
    return null;
  }}

  // Ask the server for the description of the current user's role and redraw.
  async function showEndpointsForCurrentUser(system) {{
    const token = currentToken(system);
    if (!ready || token === shownToken) return;
    shownToken = token;
    const request = ++lastRequest;
    let response = await fetch(SPEC_URL, {{ headers: token ? {{ Authorization: "Bearer " + token }} : {{}} }});
    if (response.status === 401) response = await fetch(SPEC_URL); // expired token: visitor view
    if (request === lastRequest) system.specActions.updateSpec(await response.text());
  }}

  // After every login (Authorize), logout or restored login, redraw for the new role.
  function redrawAfter(action, system) {{
    return (...args) => {{
      const result = action(...args);
      setTimeout(() => showEndpointsForCurrentUser(system), 0);
      return result;
    }};
  }}
  const RoleBasedDocsPlugin = () => ({{
    statePlugins: {{
      auth: {{
        wrapActions: {{
          authorize: redrawAfter,
          authorizeOauth2: redrawAfter,
          restoreAuthorization: redrawAfter,
          logout: redrawAfter,
        }},
      }},
    }},
  }});

  window.ui = SwaggerUIBundle({{
    url: SPEC_URL,
    dom_id: "#swagger-ui",
    presets: [SwaggerUIBundle.presets.apis, SwaggerUIBundle.SwaggerUIStandalonePreset],
    layout: "BaseLayout",
    plugins: [RoleBasedDocsPlugin],
    persistAuthorization: true,  // stay logged in after a page refresh
    onComplete: () => {{
      ready = true;
      showEndpointsForCurrentUser(window.ui);
    }},
  }});
</script>
</body>
</html>
"""


@router.get("/docs", include_in_schema=False)
async def swagger_page() -> HTMLResponse:
    """The Swagger UI page. Which endpoints it shows depends on who logs in (Authorize)."""
    return HTMLResponse(SWAGGER_PAGE)


@router.get("/api/docs/openapi.json", include_in_schema=False)
async def openapi_for_caller(request: Request, user: OptionalUser) -> dict:
    """The API description with only the endpoints the caller's role may call (no token = visitor)."""
    role = user.role.value if user else None
    return openapi_for_role(request.app.openapi(), role)  # app.openapi(): the full description


