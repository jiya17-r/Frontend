- role_may_call() answers "may this role call this endpoint at all?" from the same
  policy.csv. Swagger (/docs) uses it to show each role only its own endpoints, so what
  users SEE always matches what is ENFORCED.

from app.policy.endpoints import Endpoint



def role_may_call(role: str | None, endpoint: Endpoint) -> bool:
    """
    May `role` call this endpoint at all? `role` is None for a visitor without a token.

    public -> everyone; logged_in -> any role; policy -> the role has a rule for the
    endpoint's (resource, action) in policy.csv. An ABAC rule ("only my own orders") still
    counts as "may call": which RECORDS are allowed is decided per request.
    """
    if endpoint.access == "public":
        return True
    if role is None:
        return False
    if endpoint.access == "logged_in":
        return True
    return bool(enforcer.get_filtered_policy(0, role, endpoint.resource, endpoint.action))


