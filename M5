/**
 * Checkout page: review the order, choose a payment method (Credit Card or Cash on Delivery)
 * and place the order with POST /api/orders/checkout.
 *
 * - Place Order is disabled while the request runs (no double orders on a double click).
 * - 201 (Credit Card paid, or Cash on Delivery): go to the new order, "Your order has been placed".
 * - 402 (payment declined or gateway down): the order was saved as "Payment Failed" and the
 *   cart was emptied. The error body carries order_id, so we open that order, where the
 *   customer can Retry Payment or Move items back to cart.
 * - 409 (out of stock) / 422 (empty cart): nothing was changed; the message is shown here.
 */
import { useEffect, useState } from "react";
import { Link, Navigate, useNavigate } from "react-router-dom";
import { PAYMENT_METHODS, placeOrder } from "../api/orderApi";
import Alert, { errorText } from "../components/common/Alert";
import Loader from "../components/common/Loader";
import OrderItemsTable from "../components/orders/OrderItemsTable";
import { useCart } from "../context/CartContext";

export default function CheckoutPage() {
  const { cart, refreshCart } = useCart();
  const navigate = useNavigate();
  const [ready, setReady] = useState(false); // true once the latest cart is loaded
  const [paymentMethod, setPaymentMethod] = useState(PAYMENT_METHODS.CREDIT_CARD);
  const [submitting, setSubmitting] = useState(false);
  const [serverError, setServerError] = useState("");

  // Review the CURRENT cart (prices and stock may have changed since it was last loaded).
  useEffect(() => {
    refreshCart().finally(() => setReady(true));
  }, [refreshCart]);

  if (!ready) return <Loader text="Loading your order..." />;
  if (cart.items.length === 0 && !submitting) return <Navigate to="/cart" replace />;

  async function handlePlaceOrder() {
    setSubmitting(true);
    setServerError("");
    try {
      const order = await placeOrder(paymentMethod);
      await refreshCart(); // the backend emptied the cart
      navigate(`/orders/${order.id}`, { state: { justPlaced: true } });
    } catch (error) {
      if (error.status === 402 && error.body.order_id) {
        await refreshCart(); // the order exists (Payment Failed) and the cart was emptied
        navigate(`/orders/${error.body.order_id}`);
        return;
      }
      setServerError(errorText(error)); // e.g. 409 out of stock: nothing was changed
      setSubmitting(false);
    }
  }

  return (
    <section className="page narrow">
      <h1>Checkout</h1>
      <Alert>{serverError}</Alert>

      <h2>Review your order</h2>
      <OrderItemsTable items={cart.items} total={cart.total} />

      <fieldset className="payment-methods" disabled={submitting}>
        <legend>Payment method</legend>
        {Object.values(PAYMENT_METHODS).map((method) => (
          <label key={method} className="radio">
            <input
              type="radio"
              name="paymentMethod"
              value={method}
              checked={paymentMethod === method}
              onChange={(event) => setPaymentMethod(event.target.value)}
            />
            {method}
          </label>
        ))}
      </fieldset>

      <div className="form-actions">
        <button type="button" className="btn btn-success" onClick={handlePlaceOrder} disabled={submitting}>
          {submitting ? "Placing order..." : "Place Order"}
        </button>
        <Link to="/cart" className="btn btn-outline">
          Back to Cart
        </Link>
      </div>
    </section>
  );
}


