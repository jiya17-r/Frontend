  const navigate = useNavigate();
  const { refreshCart } = useCart();
  // The loaded order, remembered with the id it belongs to ("loading" = not loaded for this id yet).
  const [result, setResult] = useState({ id: null, order: null, error: "" });
  const [busy, setBusy] = useState(false);
  const [actionError, setActionError] = useState("");
  const [justPaid, setJustPaid] = useState(false);

  useEffect(() => {
    let ignore = false;
    fetchOrder(orderId)
      .then((order) => !ignore && setResult({ id: orderId, order, error: "" }))
      .catch((err) => {
        if (ignore) return;
        let error = errorText(err);
        if (err.status === 403) error = "You can only view your own orders.";
        if (err.status === 404) error = "Order not found.";
        setResult({ id: orderId, order: null, error });
      });
    return () => {
      ignore = true;
    };
  }, [orderId]);

  const { order, error } = result;
  if (result.id !== orderId) return <Loader text="Loading order..." />;
  if (error || !order) {
    return (
      <section className="page narrow">
        <Alert>{error || "Order not found."}</Alert>
        <Link to="/orders">Back to order history</Link>
      </section>
    );
  }

  async function handleRetry() {
    setBusy(true);
    setActionError("");
    try {
      const paid = await retryPayment(order.id);
      setResult({ id: orderId, order: paid, error: "" });
      setJustPaid(true);
    } catch (err) {
      setActionError(errorText(err)); // 402 again, or 409 (an item went out of stock meanwhile)
      try {
        setResult({ id: orderId, order: await fetchOrder(order.id), error: "" }); // newest failure reason
      } catch {
        // keep showing the order we have
      }
    } finally {
      setBusy(false);
    }
  }

  async function handleMoveToCart() {
    setBusy(true);
    setActionError("");
    try {
      await returnToCart(order.id);
      await refreshCart(); // header badge + cart page show the returned items
      navigate("/cart", { state: { message: `Items from order ${order.order_number} are back in your cart.` } });
    } catch (err) {
      setActionError(errorText(err));
      setBusy(false);
    }
  }

  const failed = order.status === "Payment Failed";
  const confirmed = order.status === "Confirmed";
  const cashOnDelivery = order.payment_method === "Cash on Delivery";

  return (
    <section className="page">
      <Link to="/orders" className="back-link">
        ← Back to order history
      </Link>
      <h1>Order {order.order_number}</h1>

      {(location.state?.justPlaced || justPaid) && confirmed && (
        <Alert type="success">
          Thank you! Your order has been placed.{cashOnDelivery && " Please pay in cash when it is delivered."}
        </Alert>
      )}
      {failed && (
        <Alert type="error">
          Payment failed: {order.failure_reason ?? "the payment could not be completed"}. This order is not confirmed.
          Retry the payment, or move the items back to your cart to change your order.
        </Alert>
      )}
      {order.status === "Cancelled" && (
        <Alert type="info">This order was cancelled and its items were moved back to your cart.</Alert>
      )}
      <Alert>{actionError}</Alert>

      <dl className="order-meta">
        <dt>Date</dt>
        <dd>{formatDate(order.created_at)}</dd>
        <dt>Status</dt>
        <dd>
          <StatusBadge status={order.status} />
        </dd>
        <dt>Payment</dt>
        <dd>
          {order.payment_method && `${order.payment_method} · `}
          <StatusBadge status={order.payment_status} />
        </dd>
        {order.payment_reference && (
          <>
            <dt>Reference</dt>
            <dd>{order.payment_reference}</dd>
          </>
        )}
      </dl>

      <OrderItemsTable items={order.items} total={order.total_amount} />

      {failed && (
        <div className="form-actions">
          <button type="button" className="btn btn-primary" onClick={handleRetry} disabled={busy}>
            {busy ? "Please wait..." : "Retry Payment"}
          </button>
          <button type="button" className="btn btn-outline" onClick={handleMoveToCart} disabled={busy}>
            Move items back to cart
          </button>
        </div>
      )}
    </section>
  );
}

