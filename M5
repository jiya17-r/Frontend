/** Order and payment endpoints (backend: app/routes/orders.py, payments.py). Customer token required. */
import { apiRequest } from "./client";

/** The two payment methods the checkout offers (the backend's PaymentMethod values). */
export const PAYMENT_METHODS = {
  CREDIT_CARD: "Credit Card",
  CASH_ON_DELIVERY: "Cash on Delivery",
};

/** GET /api/orders/me - only the logged-in user's orders, newest first. */
export function fetchMyOrders() {
  return apiRequest("/api/orders/me");
}

/** GET /api/orders/{id} - 403 if the order belongs to someone else, 404 if it doesn't exist. */
export function fetchOrder(orderId) {
  return apiRequest(`/api/orders/${orderId}`);
}

/**
 * POST /api/orders/checkout - turn the cart into an order.
 * 201: confirmed order. 402: payment failed - the error's body has order_id (order saved
 * as "Payment Failed", never confirmed). 409: out of stock. 422: empty cart.
 */
export function placeOrder(paymentMethod) {
  return apiRequest("/api/orders/checkout", { method: "POST", body: { payment_method: paymentMethod } });
}

/** POST /api/payments/process - pay a "Payment Failed" order again. 402 if it fails again. */
export function retryPayment(orderId) {
  return apiRequest("/api/payments/process", { method: "POST", body: { order_id: orderId } });
}

/** POST /api/orders/{id}/return-to-cart - cancel a failed order and put its items back in the cart. */
export function returnToCart(orderId) {
  return apiRequest(`/api/orders/${orderId}/return-to-cart`, { method: "POST" });
}


