"""
Order routes: checkout, my order history, one order, move a failed order back to the cart.

Student notes:
- Checkout is the flow refactored from sync (Week 2) to ASYNC: see services/order_service.py.
  The response comes back as soon as the order is saved and the payment answered; the
  confirmation e-mail and the audit row are background tasks, sent after the response.
- Checkout answers 201 ONLY when the order is confirmed. If the payment fails, the order is
  saved as "Payment Failed" (never "Confirmed") and the answer is 402 with the order id:
  {"detail": "...", "order_id": 7, "order_number": "ORD-...", "request_id": "..."}.
  The client retries with POST /api/payments/process {"order_id": 7}, or gives up with
  POST /api/orders/7/return-to-cart.
- /orders/me is declared BEFORE /orders/{order_id}, otherwise "me" would be read as an id.
"""

from typing import Annotated

from fastapi import APIRouter, Body, Depends, status

from app.models import OrderStatus, User
from app.policy import check_permission
from app.routes.dependencies import AuditDep, CurrentUser, NotificationsDep, OrderServiceDep, authorize
from app.schemas import CheckoutRequest, OrderOut

router = APIRouter(prefix="/api/orders", tags=["Orders"])


@router.post("/checkout", response_model=OrderOut, status_code=status.HTTP_201_CREATED)
async def checkout(
    user: Annotated[User, Depends(authorize("orders", "checkout"))],
    service: OrderServiceDep,
    notifications: NotificationsDep,
    audit: AuditDep,
    data: Annotated[CheckoutRequest | None, Body()] = None,
):
    """
    Turn the cart into an order and pay for it.

    422 empty cart, 409 a product is unavailable or out of stock (nothing is changed).
    Body (optional): {"payment_method": "Credit Card"} or {"payment_method": "Cash on Delivery"}.
    Cash on Delivery: confirmed at once, payment "Pending" until delivery (no gateway call).
    Payment declined or gateway down: 402 with order_id; the order is "Payment Failed", stock released.
    """
    payment_method = (data or CheckoutRequest()).payment_method
    order = await service.checkout(user.id, payment_method)
    audit.record(user.id, "checkout", "orders", order.id, f"{order.order_number}: {order.status.value}")
    if order.status == OrderStatus.CONFIRMED:
        notifications.order_confirmed(order.id)  # runs after the response is sent
    return order


@router.get("/me", response_model=list[OrderOut])
async def my_orders(user: Annotated[User, Depends(authorize("orders", "read_own"))], service: OrderServiceDep):
    """The caller's orders, newest first; [] if there are none."""
    return await service.list_my_orders(user.id)


@router.get("/{order_id}", response_model=OrderOut)
async def get_order(order_id: int, current_user: CurrentUser, service: OrderServiceDep):
    """One order. Customers: only their own (403). Support and admins: any order."""
    order = await service.get_order(order_id)
    # ABAC: the answer depends on who placed this order.
    check_permission(current_user, "orders", "read", owner_id=order.user_id)
    return order


@router.post("/{order_id}/return-to-cart", response_model=OrderOut)
async def return_order_to_cart(order_id: int, current_user: CurrentUser, service: OrderServiceDep, audit: AuditDep):
    """
    Cancel a "Payment Failed" order and put its items back into the cart, so the customer can
    change the cart (add or remove items) and check out again.

    403 someone else's order, 404 unknown order, 409 the order isn't "Payment Failed".
    """
    order = await service.get_order(order_id)
    # ABAC: only the customer who placed the order.
    check_permission(current_user, "orders", "return_to_cart", owner_id=order.user_id)
    order = await service.return_to_cart(order)
    audit.record(current_user.id, "return_to_cart", "orders", order.id, order.order_number)
    return order


