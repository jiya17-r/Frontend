from app.models import Category, Product
    async def search(
        self,
        *,
        text: str | None = None,
        category_id: int | None = None,
        min_price: Decimal | None = None,
        max_price: Decimal | None = None,
        skip: int = 0,
        limit: int = 20,
    ) -> list[Product]:
        """Active products matching every filter. `text` searches name, description and category name."""
        query = select(Product).join(Category, Category.id == Product.category_id).where(Product.is_active.is_(True))
        if text:
            pattern = f"%{text}%"
            query = query.where(
                or_(Product.name.ilike(pattern), Product.description.ilike(pattern), Category.name.ilike(pattern))
            )
        if category_id is not None:
            query = query.where(Product.category_id == category_id)
        if min_price is not None:
            query = query.where(Product.price >= min_price)
        if max_price is not None:
            query = query.where(Product.price <= max_price)
        query = query.order_by(Product.name).offset(skip).limit(limit)
        return list(await self.db.scalars(query))


