/**
 * App: the routes. Every page renders inside <Layout> (Header + Main Content + Footer).
 *
 *   /                      home page                    (public)          <- Milestone 1
 *   /register, /login                                   (public)          <- Milestone 1
 *   /products              product listing + search     (public)          <- Milestone 2
 *   /products/:productId   product details              (public)          <- Milestone 2
 *   /cart                  the customer's cart          (customers only)  <- Milestone 3
 *   /orders                my order history             (customers only)  <- Milestone 4
 *   /orders/:orderId       one order's details          (customers only)  <- Milestone 4
 *   /checkout              placeholder until Milestone 5 (customers only)
 */
import { Link, Route, Routes } from "react-router-dom";
import ProtectedRoute from "./components/common/ProtectedRoute";
import Layout from "./components/layout/Layout";
import CartPage from "./pages/CartPage";
import HomePage from "./pages/HomePage";
import LoginPage from "./pages/LoginPage";
import NotFoundPage from "./pages/NotFoundPage";
import OrderDetailsPage from "./pages/OrderDetailsPage";
import OrderHistoryPage from "./pages/OrderHistoryPage";
import ProductDetailsPage from "./pages/ProductDetailsPage";
import ProductListPage from "./pages/ProductListPage";
import RegisterPage from "./pages/RegisterPage";

const CUSTOMER_ONLY = ["customer"];

/** Wrap a page so only logged-in customers can open it. */
function customerPage(page) {
  return <ProtectedRoute roles={CUSTOMER_ONLY}>{page}</ProtectedRoute>;
}

/** Where the cart's Checkout button leads until the real checkout page (Milestone 5). */
function CheckoutPlaceholder() {
  return (
    <section className="page narrow">
      <h1>Checkout</h1>
      <p className="muted">Order placement arrives in Milestone 5.</p>
      <Link to="/cart">Back to cart</Link>
    </section>
  );
}

export default function App() {
  return (
    <Routes>
      <Route element={<Layout />}>
        <Route index element={<HomePage />} />
        <Route path="register" element={<RegisterPage />} />
        <Route path="login" element={<LoginPage />} />
        <Route path="products" element={<ProductListPage />} />
        <Route path="products/:productId" element={<ProductDetailsPage />} />
        <Route path="cart" element={customerPage(<CartPage />)} />
        <Route path="orders" element={customerPage(<OrderHistoryPage />)} />
        <Route path="orders/:orderId" element={customerPage(<OrderDetailsPage />)} />
        <Route path="checkout" element={customerPage(<CheckoutPlaceholder />)} />
        <Route path="*" element={<NotFoundPage />} />
      </Route>
    </Routes>
  );
}


