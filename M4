/**
 * Order details page: every product, quantity and price of one order, plus its status.
 *
 * - GET /api/orders/{id}: the backend answers 403 if the order belongs to someone else
 *   and 404 if it doesn't exist; both get a clear message.
 * - A "Payment Failed" order shows why. (Milestone 5 adds Retry Payment and
 *   "Move items back to cart" here.)
 */
import { useEffect, useState } from "react";
import { Link, useParams } from "react-router-dom";
import { fetchOrder } from "../api/orderApi";
import Alert, { errorText } from "../components/common/Alert";
import Loader from "../components/common/Loader";
import StatusBadge from "../components/common/StatusBadge";
import OrderItemsTable from "../components/orders/OrderItemsTable";
import { formatDate } from "../utils/format";

export default function OrderDetailsPage() {
  const { orderId } = useParams();
  // The loaded order, remembered with the id it belongs to ("loading" = not loaded for this id yet).
  const [result, setResult] = useState({ id: null, order: null, error: "" });

  useEffect(() => {
    let ignore = false;
    fetchOrder(orderId)
      .then((order) => !ignore && setResult({ id: orderId, order, error: "" }))
      .catch((err) => {
        if (ignore) return;
        let error = errorText(err);
        if (err.status === 403) error = "You can only view your own orders.";
        if (err.status === 404) error = "Order not found.";
        setResult({ id: orderId, order: null, error });
      });
    return () => {
      ignore = true;
    };
  }, [orderId]);

  const { order, error } = result;
  if (result.id !== orderId) return <Loader text="Loading order..." />;
  if (error || !order) {
    return (
      <section className="page narrow">
        <Alert>{error || "Order not found."}</Alert>
        <Link to="/orders">Back to order history</Link>
      </section>
    );
  }

  return (
    <section className="page">
      <Link to="/orders" className="back-link">
        ← Back to order history
      </Link>
      <h1>Order {order.order_number}</h1>

      {order.status === "Payment Failed" && (
        <Alert type="error">Payment failed: {order.failure_reason ?? "the payment could not be completed"}.</Alert>
      )}

      <dl className="order-meta">
        <dt>Date</dt>
        <dd>{formatDate(order.created_at)}</dd>
        <dt>Status</dt>
        <dd>
          <StatusBadge status={order.status} />
        </dd>
        <dt>Payment</dt>
        <dd>
          {order.payment_method && `${order.payment_method} · `}
          <StatusBadge status={order.payment_status} />
        </dd>
        {order.payment_reference && (
          <>
            <dt>Reference</dt>
            <dd>{order.payment_reference}</dd>
          </>
        )}
      </dl>

      <OrderItemsTable items={order.items} total={order.total_amount} />
    </section>
  );
}


