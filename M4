/**
 * Menu: links to the different sections of the app. NavLink highlights the current page.
 * Milestone 1: Home, and Login/Register for logged-out users.
 * Milestone 2: Products (also highlighted on a product's details page).
 * Milestone 3: Cart, for logged-in customers.
 * Milestone 4: Orders, for logged-in customers.
 */
import { NavLink } from "react-router-dom";
import { useAuth } from "../../context/AuthContext";

const linkClass = ({ isActive }) => (isActive ? "menu-link active" : "menu-link");

export default function Menu() {
  const { isLoggedIn, isCustomer } = useAuth();

  return (
    <nav className="menu" aria-label="Main navigation">
      <NavLink to="/" end className={linkClass}>
        Home
      </NavLink>
      <NavLink to="/products" className={linkClass}>
        Products
      </NavLink>
      {isCustomer && (
        <>
          <NavLink to="/cart" className={linkClass}>
            Cart
          </NavLink>
          <NavLink to="/orders" className={linkClass}>
            Orders
          </NavLink>
        </>
      )}
      {!isLoggedIn && (
        <>
          <NavLink to="/login" className={linkClass}>
            Login
          </NavLink>
          <NavLink to="/register" className={linkClass}>
            Register
          </NavLink>
        </>
      )}
    </nav>
  );
}


