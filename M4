/**
 * Order endpoints (backend: app/routes/orders.py). Customer token required.
 * Milestone 5 adds placeOrder (checkout) and retryPayment here.
 */
import { apiRequest } from "./client";

/** GET /api/orders/me - only the logged-in user's orders, newest first. */
export function fetchMyOrders() {
  return apiRequest("/api/orders/me");
}

/** GET /api/orders/{id} - 403 if the order belongs to someone else, 404 if it doesn't exist. */
export function fetchOrder(orderId) {
  return apiRequest(`/api/orders/${orderId}`);
}


