async def test_product_image_can_be_set_and_changed(client, admin, category, login_as):
    login_as(admin)
    created = await client.post(
        "/api/admin/products", json=new_product(category.id, image_url="/images/products/book-101.jpg")
    )
    product_id = created.json()["id"]

    updated = await client.put(
        f"/api/admin/products/{product_id}", json={"image_url": "https://example.com/clean-code.jpg"}
    )

    assert created.json()["image_url"] == "/images/products/book-101.jpg"
    assert updated.json()["image_url"] == "https://example.com/clean-code.jpg"
    assert (await client.get(f"/api/products/{product_id}")).json()["image_url"] == updated.json()["image_url"]


