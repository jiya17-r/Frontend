/**
 * ProductImage: the product's picture, or its initials when there is none.
 *
 * - image_url comes from the API: a path served by the frontend's public/ folder
 *   ("/images/products/elec-001.jpg") or a full web address ("https://...").
 * - If the picture is missing or fails to load (wrong name, file not added yet), onError
 *   switches to the initials, so the page never shows a broken-image icon.
 * - alt text describes the picture for screen readers.
 */
import { useState } from "react";
import PropTypes from "prop-types";
import { initials } from "../../utils/format";

export default function ProductImage({ name, imageUrl, className }) {
  // Remember WHICH url failed: if the admin changes the picture, the new url is tried again.
  const [failedUrl, setFailedUrl] = useState(null);

  if (!imageUrl || failedUrl === imageUrl) {
    return (
      <span className={`${className} product-initials`} aria-hidden="true">
        {initials(name)}
      </span>
    );
  }
  return (
    <img
      src={imageUrl}
      alt={name}
      className={`${className} product-img`}
      loading="lazy"
      onError={() => setFailedUrl(imageUrl)}
    />
  );
}

ProductImage.propTypes = {
  name: PropTypes.string.isRequired,
  imageUrl: PropTypes.string,
  className: PropTypes.string,
};

